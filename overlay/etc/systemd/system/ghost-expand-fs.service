[Unit]
Description=ghOSt first-boot root filesystem expansion
# / must be mounted before this can run, and it must finish before firstboot
# asks the user anything. DefaultDependencies stays on: the old
# Before=local-fs-pre.target/After=local-fs.target pair was an ordering cycle.
After=local-fs.target
Before=firstboot.service
ConditionPathExists=!/var/lib/ghost/.fs_expanded

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ghost-expand-fs.sh
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
